<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="20">
            <TextBlock 
                Text="Apperance"  
                FontSize="28" 
                FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock
                    Text="Select theme:"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"/>
                <ComboBox x:Name="ThemeSelector"
                    SelectionChanged="ThemeSelector_SelectionChanged">

                    <ComboBoxItem Content="Light" Tag="Light"/>
                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock
                    Text="Resolution:"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"/>
                <ComboBox x:Name="ResolutionSelector"
                          SelectionChanged="ResolutionSelector_SelectionChanged">
                    
                    <ComboBoxItem Content="1920x1080" Tag="Large"/>
                    <ComboBoxItem Content="1600x900" Tag="Medium"/>
                    <ComboBoxItem Content="1280x720" Tag="Small"/>
                </ComboBox>
            </StackPanel>

            <TextBlock
                Text="About"
                FontSize="28"
                FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    Text="Version:"
                    FontWeight="SemiBold"/>
                <TextBlock Text="1.0.0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    Text="GitHub:"
                    FontWeight="SemiBold"/>
                <TextBlock Text="https://github.com/DavidKN10/Native-Metrics"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    Text="License:"
                    FontWeight="SemiBold"/>
                <TextBlock Text="MIT"/>
            </StackPanel>
            
        </StackPanel> 
    </ScrollViewer>
    
</Page>
