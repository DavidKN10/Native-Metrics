<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.Performance.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views.Performance"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Spacing="20">

        <StackPanel 
                Spacing="15" 
                Orientation="Horizontal">
            <TextBlock
                    Text="{Binding DriveLetter}"
                    FontSize="28"
                    FontWeight="SemiBold"/>

            <TextBlock 
                    Text="{Binding VolumeName}"
                    FontSize="28"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <TextBlock 
                Text="{Binding Model}"
                FontSize="18"
                FontWeight="SemiBold"/>

        <StackPanel Spacing="15" Orientation="Horizontal">
            <TextBlock
                    Text="GUID:"
                    FontSize="15"
                    FontWeight="SemiBold"/>
            <TextBlock 
                    Text="{Binding Guid}"
                    FontSize="15"/>
        </StackPanel>

        <TextBlock Text="{Binding BusType}"/>
        <TextBlock Text="{Binding FileSystemName}"/>
        <TextBlock Text="{Binding DriveType}"/>
       
        <Grid
            ColumnSpacing="20"
            RowSpacing="8">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Total:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding TotalSpaceFormatted.ValueString}"/>
            
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Text="Available:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="0"
                Grid.Column="3"
                Text="{Binding AvailableSpaceFormatted.ValueString}"/>
        
            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                Text="Free:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="0"
                Grid.Column="5"
                Text="{Binding FreeSpaceFormatted.ValueString}"/>
         
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="Read:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding BytesReadFormatted.ValueString}"/>

            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Text="Written:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="1"
                Grid.Column="3"
                Text="{Binding BytesWrittenFormatted.ValueString}"/>
            
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Read Speed:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding ReadSpeedFormatted.ValueString}"/>

            <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                Text="Write Speed:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="2"
                Grid.Column="3"
                Text="{Binding WriteSpeedFormatted.ValueString}"/>

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Active time:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding ActiveTimeFormatted.ValueString}"/>
            
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                Text="Transfer rate:"
                FontWeight="SemiBold"/>
            <TextBlock
                Grid.Row="3"
                Grid.Column="3"
                Text="{Binding TransferRateFormatted.ValueString}"/>
        </Grid>

    </StackPanel>
</Page>
