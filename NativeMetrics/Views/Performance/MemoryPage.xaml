<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">
   
    <StackPanel Spacing="20">
        <TextBlock Text="Memory"
                   FontSize="24"
                   FontWeight="Bold"/>

        <TextBlock Text="Memory usage"
                   FontWeight="SemiBold"
                   Margin="0, 15, 0, 0"/>
        <lvc:CartesianChart
            x:Name="MemoryUseChart"
            LegendPosition="Hidden"
            Height="300"
            Width="1000">

            <lvc:CartesianChart.Series>
                <lvc:SeriesCollection>
                    <lvc:XamlLineSeries
                        GeometrySize="0"
                        LineSmoothness="0"
                        SeriesName="Memory Usage"
                        GeometryFill="{x:Null}"
                        GeometryStroke="{x:Null}"
                        Stroke="{lvc:SolidColorPaint Color='#0240fa', StrokeWidth=2}"
                        Values="{x:Bind _manager.MemoryStats.MemoryUseObservable, Mode=OneWay}"/>
                </lvc:SeriesCollection>
            </lvc:CartesianChart.Series>
            
        </lvc:CartesianChart>

        <Grid 
            ColumnSpacing="20"
            RowSpacing="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- First Column-->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Percent Use:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="{x:Bind _manager.MemoryStats.MemoryUsePercentFormatted.ValueString, Mode=OneWay}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Total:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{x:Bind _manager.MemoryStats.TotalMemoryFormatted.ValueString, Mode=OneWay}"/>
           
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Available:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{x:Bind _manager.MemoryStats.AvailableMemoryFormatted.ValueString, Mode=OneWay}"/>
           
            <!-- Second Column-->
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Commit current:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="3"
                       Text="{x:Bind _manager.MemoryStats.CommitCurrentFormatted.ValueString, Mode=OneWay}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="Commit limit:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="3"
                       Text="{x:Bind _manager.MemoryStats.CommitLimitFormatted.ValueString, Mode=OneWay}"/>
           
            <TextBlock Grid.Row="2"
                       Grid.Column="2"
                       Text="Commit peak:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="3"
                       Text="{x:Bind _manager.MemoryStats.CommitPeakFormatted.ValueString, Mode=OneWay}"/>           
            
            <!-- Third Column-->
            <TextBlock Grid.Row="0"
                       Grid.Column="4"
                       Text="Page size:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="5"
                       Text="{x:Bind _manager.MemoryStats.PageSizeFormatted.ValueString, Mode=OneWay}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="Paged pool:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="5"
                       Text="{x:Bind _manager.MemoryStats.PagedPoolFormatted.ValueString, Mode=OneWay}"/>
           
            <TextBlock Grid.Row="2"
                       Grid.Column="4"
                       Text="Non-Paged pool:"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="5"
                       Text="{x:Bind _manager.MemoryStats.NonPagedPoolFormatted.ValueString, Mode=OneWay}"/>          
        </Grid>
        
    </StackPanel>
    
</Page>
