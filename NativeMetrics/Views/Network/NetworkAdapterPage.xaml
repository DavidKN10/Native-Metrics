<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.Network.NetworkAdapterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views.Network"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">
    
    <ScrollViewer>
        <StackPanel Spacing="20">
            <TextBlock Text="{Binding Alias}"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" 
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <StackPanel
                Spacing="15"
                Orientation="Horizontal">
                <TextBlock
                    Text="LUID:"
                    FontSize="15"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="{Binding Luid}"
                    FontSize="15"/>
            </StackPanel>
           
            <Grid
                ColumnSpacing="20"
                RowSpacing="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Received:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding ReceivedBFormatted.ValueString}"/>
 
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Sent:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding SentBFormatted.ValueString}"/>               
 
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="Download:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="{Binding DownloadBpsFormatted.ValueString}"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="Upload:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{Binding UploadBpsFormatted.ValueString}"/>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Received link speed:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding ReceivedLSbFormatted.ValueString}"/>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="Transmit link speed:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding TransmitLSbFormatted.ValueString}"/>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="Throughput:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="3"
                    Text="{Binding ThroughputFormatted.ValueString}"/>
            </Grid>
            
        </StackPanel>
        
    </ScrollViewer>
    
</Page>
