<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views"
    xmlns:gpuvm="using:NativeMetrics.Services.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="20,10,0,0">
        
        <StackPanel Spacing="20">
            
            <TextBlock
                Text="Windows Info"
                FontSize="28"
                FontWeight="SemiBold"/>
            <Grid 
                ColumnSpacing="20" 
                RowSpacing="10">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
               
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Edition:"
                    FontWeight="SemiBold"/>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="5"
                    Orientation="Horizontal">
                        <TextBlock Text="{x:Bind _viewModel.WindowsEdition}"/>
                        <TextBlock Text="{x:Bind _viewModel.WindowsVersion}"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="OS Build:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.BuildNumber}"/>
            </Grid>            
            
            <TextBlock
                Text="Device Info"
                FontSize="28"
                FontWeight="SemiBold"/>
            <Grid 
                ColumnSpacing="20" 
                RowSpacing="10">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
               
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Device name:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.DeviceName}"/>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="System type:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.SystemType}"/>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Firmware:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.Firmware}"/>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="Hostname:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.Hostname}"/>

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="Processor:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.Processor}"/>

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Text="Installed RAM:"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Text="{x:Bind _viewModel.InstalledRamFormatted.ValueString}"/>

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Text="Storage"
                    FontWeight="SemiBold"/>
                <StackPanel 
                    Grid.Row="6"
                    Grid.Column="1"
                    Spacing="5" 
                    Orientation="Horizontal">
                    <TextBlock Text="{x:Bind _viewModel.UsedStorageFormatted.ValueString}"/>
                    <TextBlock Text="/"/>
                    <TextBlock Text="{x:Bind _viewModel.StorageCapacityFormatted.ValueString}"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Text="Graphics cards:"
                    FontWeight="SemiBold"/>
                <ListView
                    Grid.Row="7"
                    Grid.Column="1"
                    ItemsSource="{x:Bind _viewModel.GpuList, Mode=OneWay}"
                    SelectionMode="None"
                    Margin="-15,-10,0,0">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="gpuvm:GpuSummary">
                            <StackPanel Orientation="Vertical" Spacing="5">
                                <TextBlock Text="{x:Bind name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
                
            </Grid>

        </StackPanel>
        
    </ScrollViewer>
    
</Page>
