<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <tv:TableView 
            Grid.Row="1"
            ItemsSource="{x:Bind _processManager.Processes}" 
            AutoGenerateColumns="False" 
            IsReadOnly="True" 
            HeadersVisibility="Columns"
            SelectionUnit="Row"
            SelectionMode="Single"
            GridLinesVisibility="Vertical">

            <tv:TableView.CellStyle>
                <Style TargetType="tv:TableViewCell">
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </tv:TableView.CellStyle>
             
            <tv:TableView.Columns>
                <tv:TableViewTextColumn Header="Name" Binding="{Binding ProcessName}" Width="250" />
                <tv:TableViewNumberColumn Header="ID" Binding="{Binding ProcessId}" Width="80" />
                <tv:TableViewNumberColumn Header="Threads" Binding="{Binding ThreadsCount}" Width="90" />
                <tv:TableViewNumberColumn Header="Parent ID" Binding="{Binding ParentProcessId}" Width="95" />
                <tv:TableViewNumberColumn Header="Usage" Binding="{Binding MemoryUsage}" Width="100" />
                <tv:TableViewNumberColumn Header="Commit" Binding="{Binding CommitSize}" Width="100" />
                <tv:TableViewNumberColumn Header="Private" Binding="{Binding PrivateMemory}" Width="100" />
            </tv:TableView.Columns> 
        </tv:TableView>
    </Grid>
</Page>
