<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NativeMetrics.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NativeMetrics.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <tv:TableView 
            Grid.Row="1"
            ItemsSource="{x:Bind _processManager.Processes}" 
            AutoGenerateColumns="False" 
            IsReadOnly="True" 
            HeadersVisibility="Columns"
            SelectionUnit="Row"
            SelectionMode="Single"
            GridLinesVisibility="Vertical">

            <tv:TableView.CellStyle>
                <Style TargetType="tv:TableViewCell">
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </tv:TableView.CellStyle>
             
            <tv:TableView.Columns>
                <tv:TableViewTemplateColumn Header="Name" Width="250">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="5,0">
                                <Image Source="{Binding IconSource}" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate> 
                </tv:TableViewTemplateColumn> 
                
                <tv:TableViewTextColumn Header="ID" Binding="{Binding ProcessId}" Width="80" />
                <tv:TableViewTextColumn Header="Threads" Binding="{Binding ThreadsCount}" Width="90" />
                <tv:TableViewTextColumn Header="Parent ID" Binding="{Binding ParentProcessId}" Width="95" />
                
                <tv:TableViewTemplateColumn Header="Usage" Width="100">
                    <tv:TableViewTemplateColumn.HeaderStyle>
                        <Style TargetType="tv:TableViewColumnHeader">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style> 
                    </tv:TableViewTemplateColumn.HeaderStyle>
                    <tv:TableViewTemplateColumn.CellStyle>
                        <Style TargetType="tv:TableViewCell">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </tv:TableViewTemplateColumn.CellStyle>
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MemoryUsage}"/>
                                <TextBlock Text=" MB"/>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate> 
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn Header="Commit" Width="100">
                    <tv:TableViewTemplateColumn.HeaderStyle>
                        <Style TargetType="tv:TableViewColumnHeader">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style> 
                    </tv:TableViewTemplateColumn.HeaderStyle>
                    <tv:TableViewTemplateColumn.CellStyle>
                        <Style TargetType="tv:TableViewCell">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </tv:TableViewTemplateColumn.CellStyle>
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CommitSize}"/>
                                <TextBlock Text=" MB"/>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn Header="Private" Width="100">
                    <tv:TableViewTemplateColumn.HeaderStyle>
                        <Style TargetType="tv:TableViewColumnHeader">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </tv:TableViewTemplateColumn.HeaderStyle>
                    <tv:TableViewTemplateColumn.CellStyle>
                        <Style TargetType="tv:TableViewCell">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </tv:TableViewTemplateColumn.CellStyle>
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PrivateMemory}"/>
                                <TextBlock Text=" MB"/>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns> 
        </tv:TableView>
    </Grid>
</Page>
